generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  tier             Tier             @default(FREE)
  timezone         String           @default("Asia/Ho_Chi_Minh")
  isAdmin          Boolean          @default(false)
  uploadCount      Int              @default(0)
  lastResetDate    DateTime         @default(now())
  remindAt7Days    Boolean          @default(true)
  remindAt3Days    Boolean          @default(true)
  remindAt1Day     Boolean          @default(true)
  remindAtDeadline Boolean          @default(true)
  dailyDigest      Boolean          @default(true)
  darkMode         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  projects         Project[]
  pinnedDeadline   PinnedDeadline?
  paymentRequests  PaymentRequest[]

  @@map("users")
}

enum Tier {
  FREE
  PRO
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  deadline    DateTime
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  milestone   Milestone?
  shareLinks  ShareLink[]
  tasks       Task[]

  @@index([userId, status])
  @@index([deadline])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Milestone {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  deadline  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@map("milestones")
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId  String?
  milestone    Milestone? @relation(fields: [milestoneId], references: [id])
  name         String
  deadline     DateTime
  assigneeName String?
  status       TaskStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([projectId, status])
  @@index([deadline])
  @@map("tasks")
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  OVERDUE
}

model ShareLink {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  isRevoked Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([projectId])
  @@map("share_links")
}

model PinnedDeadline {
  id         String     @id @default(uuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("pinned_deadlines")
}

enum EntityType {
  PROJECT
  TASK
}

model PaymentRequest {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountVnd     Int
  referenceCode String        @unique
  status        PaymentStatus @default(PENDING)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, status])
  @@map("payment_requests")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}
